server: gorefresh . server --listen :8081 -- server --listen :8081 --data-dir ./data --enable-rate-limit --otel-endpoint localhost:4317
fetcher: gorefresh . fetch --repo NixOS/nixpkgs --data-dir ./data --poll-interval 1m
api-tester: sleep 10 && while true; do echo -e "\n[$(date)] Testing API endpoints..."; echo -n "  /health: "; curl -s http://localhost:8081/health | jq -r .status 2>/dev/null || echo "error"; echo -n "  /events count: "; curl -s "http://localhost:8081/events?limit=1" | jq '. | length' 2>/dev/null || echo "error"; echo -n "  /event-types: "; curl -s http://localhost:8081/event-types | jq -r 'length' 2>/dev/null || echo "error"; sleep 60; done
